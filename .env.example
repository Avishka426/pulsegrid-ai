# Optional AI agent configuration. Nothing in the current app reads these yet;
# agents are upcoming. Jac does not load this file for `jac run`: export the
# values in your shell instead. Never commit real values.

# Free Hugging Face access token: huggingface.co/settings/tokens
# (fine-grained, with "Make calls to Inference Providers").
HUGGINGFACE_API_KEY=

# Optional model override. Default: huggingface/openai/gpt-oss-120b
LLM_MODEL=
