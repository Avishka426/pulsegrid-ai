# Optional model configuration for the agents (agents/). Not required: without a
# key the agents report "not configured" and never fake output.
# Jac does not load this file for `jac start`: export the values in your shell.
# Never commit real values.

# Default: an open-weight model through Hugging Face Inference Providers.
# Free token: huggingface.co/settings/tokens (fine-grained, with
# "Make calls to Inference Providers"). HF_TOKEN works too.
HUGGINGFACE_API_KEY=

# Optional model override. Default: huggingface/openai/gpt-oss-120b
LLM_MODEL=

# Only needed if LLM_MODEL points at that provider (gpt-..., claude-...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set to 1 only for keyless local models (ollama/..., local:...).
PULSEGRID_ALLOW_KEYLESS_MODEL=
