# Optional model configuration for the agents (agents/). Not required: without a
# key the agents report "not configured" and never fake output.
# Set values in your local environment; never commit actual credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set to 1 only for keyless local models (ollama/..., local:...).
PULSEGRID_ALLOW_KEYLESS_MODEL=
