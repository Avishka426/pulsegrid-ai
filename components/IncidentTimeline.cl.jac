def:pub IncidentTimeline(scenario_title: str, fault_label: str, fault_id: str, active_faults: int, downstream_count: int) -> JsxElement {
    return <section className="rounded-xl border border-border bg-card p-5 shadow-sm"><h2 className="mb-3 font-semibold">Incident timeline</h2><div className="flex items-start gap-3 border-l border-border pl-4"><span className={"-ml-[21px] mt-1 size-2.5 rounded-full border-2 border-background " + ("bg-red-500" if active_faults > 0 else "bg-primary")}/><div><div className="text-sm font-medium">{(scenario_title + " · " + fault_label if scenario_title != "" else fault_label) if active_faults > 0 else "Baseline network loaded"}</div><div className="mt-1 text-xs text-muted-foreground">{(f"Fault applied at {fault_id} · {downstream_count} downstream assets traced" if active_faults > 0 else "Synthetic topology initialized · ready for simulation")}</div></div></div></section>;
}
